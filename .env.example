# Copie para .env (fora do git) e preencha.

# LLM da classificação de temas (analise/classificar.py). Troca de provedor só por configuração:
#   desenvolvimento:  LLM_PRIMARY_PROVIDER=openai            LLM_PRIMARY_MODEL=gpt-5.4-nano
#   entrega na AWS:   LLM_PRIMARY_PROVIDER=bedrock_converse  LLM_PRIMARY_MODEL=<id do modelo no Bedrock>
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_MODEL=gpt-5.4-nano
OPENAI_API_KEY=
# Bedrock usa a credencial AWS padrão (perfil em ~/.aws, variáveis AWS_* ou a IAM role do container)
AWS_REGION=us-east-1
